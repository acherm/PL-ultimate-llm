! A simple Inform 4 game
Constant Story "Hello Adventure";
Constant Headline "^An Interactive Fiction^";

Include "Parser";
Include "VerbLib";

Object Kitchen "Kitchen"
  with description "A small kitchen.",
  has light;

Object -> table "table"
  with name 'table',
       description "A wooden table.";

[ Initialise;
  location = Kitchen;
  print "Welcome to the game!^^";
];

Include "Grammar";
