//
// A simple Yoix program that demonstrates arrays and loops
//

import yoix.*.*;

Array numbers[10];
int i;

// Fill array with squares
for (i = 0; i < 10; i++) {
    numbers[i] = i * i;
}

// Print the results
printf("Squares of numbers 0-9:\n");
for (i = 0; i < 10; i++) {
    printf("%d squared is %d\n", i, numbers[i]);
}
