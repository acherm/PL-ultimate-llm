/* Producer-Consumer in Klaim
 * Producer writes items to a shared tuple space
 * Consumer reads items from the shared tuple space
 */

l_prod :: out(<"item1">)@l_buf . out(<"item2">)@l_buf . out(<"item3">)@l_buf . 0
|
l_buf  :: 0
|
l_cons :: in(<! string x>)@l_buf . in(<! string y>)@l_buf . in(<! string z>)@l_buf . 0