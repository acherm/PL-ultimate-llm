; Greatest Common Divisor (Euclidean Algorithm)
; Computes GCD(a, b) using repeated subtraction
;
; Input:  V0 = a, V1 = b
; Output: R0 = GCD(a, b)
;
; Example: gcd(48, 18) = 6

P5 gcd (V0[:16.0], V1[:16.0]) => R0[:16.0]
    V0[:16.0] => Z0[:16.0]  ; a
    V1[:16.0] => Z1[:16.0]  ; b

    ; While a != b
    W [
        ; if a > b then a = a - b
        (Z0[:16.0] > Z1[:16.0]) => Z0[:16.0] - Z1[:16.0] => Z0[:16.0]
        ; if b > a then b = b - a
        (Z1[:16.0] > Z0[:16.0]) => Z1[:16.0] - Z0[:16.0] => Z1[:16.0]
    ] (Z0[:16.0] != Z1[:16.0])

    Z0[:16.0] => R0[:16.0]
END
