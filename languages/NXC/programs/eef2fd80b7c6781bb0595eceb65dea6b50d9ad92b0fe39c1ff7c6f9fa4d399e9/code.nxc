task main()
{
  // Play a tone
  PlayTone(440, 1000);
  Wait(1000);
  
  // Move forward for 3 seconds
  OnFwd(OUT_AC, 75);
  Wait(3000);
  
  // Stop motors
  Off(OUT_AC);
  
  // Move backward
  OnRev(OUT_AC, 50);
  Wait(2000);
  
  // Stop and turn
  Off(OUT_AC);
  OnFwd(OUT_A, 75);
  OnRev(OUT_C, 75);
  Wait(1000);
  
  // Stop all
  Off(OUT_AC);
}
