BEGIN
   INTEGER PROCEDURE FACTORIAL(N);
   VALUE N;
   INTEGER N;
   BEGIN
      INTEGER RESULT;
      IF N <= 1 THEN
         RESULT := 1
      ELSE
         RESULT := N * FACTORIAL(N - 1);
      FACTORIAL := RESULT
   END;

   INTEGER I;
   FOR I := 0 STEP 1 UNTIL 10 DO
      WRITE(I, FACTORIAL(I))
END.
