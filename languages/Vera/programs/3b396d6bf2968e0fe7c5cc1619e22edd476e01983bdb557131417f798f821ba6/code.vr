program loop_control {
   integer i;
   // For loop continue
   printf("-----FOR LOOP CONTINUE---\n");
   for (i = 0 ; i < 3; i ++ ) {
     if (i == 1) continue;
     printf("Value of i is %0d\n",i);
   }
   // repeat loop continue
   i = 0;
   printf("-----REPEAT LOOP CONTINUE---\n");
   repeat (3) {
     i ++;
     if (i == 2)  {
       continue;
     }
     printf("Value of i is %0d\n",i);
   }
   // while loop continue
   printf("-----WHILE LOOP CONTINUE---\n");
   while (i > 0) {
     i --;
     if (i == 2)  {
       continue;
     }
     printf("Value of i is %0d\n",i);
   }
   // For loop break
   printf("-----FOR LOOP BREAK---\n");
   for (i = 0 ; i < 3; i ++ ) {
     if (i == 1) break;
     printf("Value of i is %0d\n",i);
   }
   // repeat loop break
   i = 0;
   printf("-----REPEAT LOOP BREAK---\n");
   repeat (3) {
     i ++;
     if (i == 2)  {
       break;
     }
     printf("Value of i is %0d\n",i);
   }
   // while loop break
   i = 5;
   printf("-----WHILE LOOP BREAK---\n");
   while (i > 0) {
     i --;
     if (i == 2)  {
       break;
     }
     printf("Value of i is %0d\n",i);
   }
}
