-- Fibonacci sequence in Asteroid
-- Demonstrates pattern matching functions

load system io.

function fib
    with 0 do
        return 0
    orwith 1 do
        return 1
    orwith n do
        return fib(n-1) + fib(n-2)
    end

for i in 0 to 10 do
    io @println("fib(" + i + ") = " + fib(i)).
end
