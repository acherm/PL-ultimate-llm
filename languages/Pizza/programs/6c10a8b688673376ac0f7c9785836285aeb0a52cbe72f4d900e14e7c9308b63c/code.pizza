class Pair<A,B> {
    A fst;
    B snd;

    Pair(A fst, B snd) {
        this.fst = fst;
        this.snd = snd;
    }

    A fst() { return fst; }
    B snd() { return snd; }
}

class PairTest {
    public static void main(String[] args) {
        Pair<String,Integer> p = new Pair<String,Integer>("hello", 42);
        System.out.println("First: " + p.fst());
        System.out.println("Second: " + p.snd());
    }
}