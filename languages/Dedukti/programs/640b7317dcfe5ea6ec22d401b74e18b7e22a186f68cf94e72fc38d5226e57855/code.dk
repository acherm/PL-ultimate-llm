Nat : Type.
zero : Nat.
succ : Nat -> Nat.

def plus : Nat -> Nat -> Nat.
[n] plus zero n --> n.
[m,n] plus (succ m) n --> succ (plus m n).

def mult : Nat -> Nat -> Nat.
[n] mult zero n --> zero.
[m,n] mult (succ m) n --> plus n (mult m n).

def two : Nat := succ (succ zero).
def four : Nat := mult two two.
