procedure PonerLinea(color, largo) {
  repeat(largo - 1) {
    Poner(color)
    Mover(Este)
  }
  Poner(color)
}

procedure VolverAlInicio(largo) {
  repeat(largo - 1) {
    Mover(Oeste)
  }
}

procedure DibujarCuadrado(color, lado) {
  repeat(4) {
    PonerLinea(color, lado)
    VolverAlInicio(lado)
    if (puedeMover(Norte)) {
      Mover(Norte)
    }
  }
}

program {
  DibujarCuadrado(Azul, 5)
}
