begin
  integer procedure factorial(n);
    value n;
    integer n;
  begin
    integer result, i;
    result := 1;
    for i := 2 step 1 until n do
      result := result * i;
    factorial := result
  end factorial;

  integer n, f;
  n := 5;
  f := factorial(n);
  outinteger(1, f);
  outstring(1, " is the factorial of ");
  outinteger(1, n)
end
