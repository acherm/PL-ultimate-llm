<?xml version="1.0" encoding="UTF-8"?>
<program>
  <header>
    <catrobatLanguageVersion>0.999</catrobatLanguageVersion>
    <description>A simple Hello World program in Catrobat</description>
    <programName>Hello World</programName>
    <screenMode>PORTRAIT</screenMode>
  </header>
  <settings/>
  <scenes>
    <scene>
      <name>Scene 1</name>
      <objectList>
        <object type="Sprite" name="Background">
          <lookList/>
          <soundList/>
          <scriptList>
            <script type="StartScript">
              <brickList>
                <brick type="SpeakBrick">
                  <formulaList>
                    <formula category="SPEAK">
                      <type>STRING</type>
                      <value>Hello World!</value>
                    </formula>
                  </formulaList>
                </brick>
              </brickList>
            </script>
          </scriptList>
        </object>
      </objectList>
    </scene>
  </scenes>
</program>
