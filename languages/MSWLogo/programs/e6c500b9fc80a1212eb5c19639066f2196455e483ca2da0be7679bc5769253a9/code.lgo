; Recursive tree drawing program
; Draws a fractal tree using turtle graphics

to tree :size :angle
  if :size < 5 [stop]
  forward :size
  left :angle
  tree :size * 0.7 :angle
  right :angle * 2
  tree :size * 0.7 :angle
  left :angle
  back :size
end

; Main program
clearscreen
penup
setxy 0 -200
pendown
setheading 0
tree 100 30