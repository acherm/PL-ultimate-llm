// Hello World trigger in Galaxy (StarCraft II scripting language)
bool TrigHelloWorld_Func(bool testConds, bool runActions) {
    if (testConds) {
    }
    if (!runActions) { return true; }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Hello, World!"));
    return true;
}

void InitMap() {
    trigger t;
    t = TriggerCreate("TrigHelloWorld_Func");
    TriggerAddEventMapInit(t);
}
