<!DOCTYPE html>
<html>
<head>
    <title>{{ title }}</title>
</head>
<body>
    <h1>{{ heading }}</h1>
    <ul>
    {% for item in items %}
        <li>{{ item.name }} - ${{ item.price }}</li>
    {% endfor %}
    </ul>
    {% if total > 0 %}
        <p>Total: ${{ total }}</p>
    {% else %}
        <p>No items in cart</p>
    {% endif %}
</body>
</html>
