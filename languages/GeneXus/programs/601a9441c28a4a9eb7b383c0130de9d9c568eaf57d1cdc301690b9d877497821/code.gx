// Factorial Calculation in GeneXus
Sub 'CalculateFactorial'
   // Input: &Number
   // Output: &Result

   If &Number < 0
      msg("Error: Number must be non-negative")
      &Result = 0
   Else
      &Result = 1
      For &i = 1 To &Number
         &Result = &Result * &i
      EndFor
   EndIf
EndSub

// Main procedure
Event Start
   &Number = 5
   Do 'CalculateFactorial'
   msg("Factorial of " + &Number.ToString() + " is " + &Result.ToString())
EndEvent