<!DOCTYPE style-sheet PUBLIC "-//James Clark//DTD DSSSL Style Sheet//EN">
<style-sheet>
<style-specification>
<style-specification-body>

(element paragraph
  (make paragraph
    font-family-name: "Times New Roman"
    font-size: 12pt
    line-spacing: 14pt))

(element title
  (make paragraph
    font-family-name: "Helvetica"
    font-size: 18pt
    font-weight: 'bold
    space-before: 12pt
    space-after: 6pt))

(element emphasis
  (make sequence
    font-posture: 'italic))

</style-specification-body>
</style-specification>
</style-sheet>
