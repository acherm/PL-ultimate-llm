// Fibonacci sequence generator
fibonacci := func(n) {
    if n <= 1 {
        return n
    }

    a := 0
    b := 1

    for i := 2; i <= n; i++ {
        temp := a + b
        a = b
        b = temp
    }

    return b
}

// Calculate and print first 10 Fibonacci numbers
fmt := import("fmt")

fmt.println("First 10 Fibonacci numbers:")
for i := 0; i < 10; i++ {
    fmt.printf("F(%d) = %d\n", i, fibonacci(i))
}
