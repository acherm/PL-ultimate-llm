// A comprehensive testcase for join success with a saved workspace
-(void) performClientJoinSuccessWithTriptychCorkboardsWhiteboardsTest
{
  STAssertFalse(communicator.isConnected, @"Communicator should not be connected before receiving join protein.");
  STAssertFalse(communicator.isConnecting, @"Communicator should not be connecting before receiving join protein.");

  NSString *key = [proteinSource proteinKeyForTransactionName:MZTransactionNameClientJoin responseType:@"response"];
  OBProtein *p = [proteinSource proteinForKey:key];
  [responsePoolConnector receivedProtein:p];
  
  STAssertTrue(communicator.isConnected, @"Communicator should be connected after receiving join success");
  STAssertFalse(communicator.isConnecting, @"Communicator should not be connecting after receiving join success");

  
  // Check Mezzanine State
  STAssertEquals(systemModel.state, MZSystemStateWorkspace, @"System state should be workspace after joining");

  
  // Check felds
  NSUInteger numberOfFelds = 3;
  STAssertEquals(systemModel.felds.count, numberOfFelds, @"Felds count should be equal");


  // Check workspace
  NSString *workspaceUid = [proteinSource parameterForKey:kCanonicalParameterWorkspaceUidKey];
  NSString *workspaceName = [proteinSource parameterForKey:kCanonicalParameterWorkspaceNameKey];
  
  STAssertEqualObjects(systemModel.currentWorkspace.uid, workspaceUid, @"Current workspace's uid should be %@", workspaceUid);
  STAssertEqualObjects(systemModel.currentWorkspace.name, workspaceName, @"Current workspace's name should be %@", workspaceName);


  // Check corkboards
  NSString *corkboard1Uid = [proteinSource parameterForKey:kCanonicalParameterCorkboardUid1Key];
  NSString *corkboard2Uid = [proteinSource parameterForKey:kCanonicalParameterCorkboardUid2Key];
  NSString *corkboard3Uid = [proteinSource parameterForKey:kCanonicalParameterCorkboardUid3Key];
  NSUInteger numberOfCorkboards = 3;
  STAssertEquals(systemModel.corkboards.count, numberOfCorkboards, @"Corkboards should be received after join success");
  if (systemModel.corkboards.count > 0)
    STAssertEqualObjects(((MZCorkboard*)systemModel.corkboards[0]).uid, corkboard1Uid, @"Corkboard 1's uid should be %@", corkboard1Uid);
  if (systemModel.corkboards.count > 1)
    STAssertEqualObjects(((MZCorkboard*)systemModel.corkboards[1]).uid, corkboard2Uid, @"Corkboard 2's uid should be %@", corkboard2Uid);
  if (systemModel.corkboards.count > 2)
    STAssertEqualObjects(((MZCorkboard*)systemModel.corkboards[2]).uid, corkboard3Uid, @"Corkboard 3's uid should be %@", corkboard3Uid);


  // Check whiteboards
  NSString *whiteboardUid = [proteinSource parameterForKey:kCanonicalParameterWhiteboardUidKey];
  NSUInteger numberOfWhiteboards = 1;
  STAssertEquals(systemModel.whiteboards.count, numberOfWhiteboards, @"Whiteboards should be received after join success");
  if (systemModel.whiteboards.count > 0)
    STAssertEqualObjects(systemModel.whiteboards[0][@"uid"], whiteboardUid, @"Whiteboard's uid should be %@", whiteboardUid);


  // Check upload limits
  NSNumber *uploadMaxWidth = [proteinSource parameterForKey:kCanonicalParameterUploadMaxWidth];
  NSNumber *uploadMaxHeight = [proteinSource parameterForKey:kCanonicalParameterUploadMaxHeight];
  NSNumber *uploadMaxImageSizeMB = [proteinSource parameterForKey:kCanonicalParameterUploadImageSizeMB];
  NSNumber *uploadMaxPDFSizeMB = [proteinSource parameterForKey:kCanonicalParameterUploadPDFSizeMB];
  NSNumber *uploadMaxSizeMB = [proteinSource parameterForKey:kCanonicalParameterUploadSizeMB];
  STAssertEquals(systemModel.uploadLimits.maxImageWidth.integerValue, uploadMaxWidth.integerValue, @"Upload max width should be %@", uploadMaxWidth);
  STAssertEquals(systemModel.uploadLimits.maxImageHeight.integerValue, uploadMaxHeight.integerValue, @"Upload max height should be %@", uploadMaxHeight);
  STAssertEquals(systemModel.uploadLimits.maxImageSize.integerValue, uploadMaxImageSizeMB.integerValue, @"Upload max image size should be %@", uploadMaxImageSizeMB);
  STAssertEquals(systemModel.uploadLimits.maxPDFSize.integerValue, uploadMaxPDFSizeMB.integerValue, @"Upload max PDF size should be %@", uploadMaxPDFSizeMB);
  STAssertEquals(systemModel.uploadLimits.maxGlobalSize.integerValue, uploadMaxSizeMB.integerValue, @"Upload max global size should be %@", uploadMaxSizeMB);
}

