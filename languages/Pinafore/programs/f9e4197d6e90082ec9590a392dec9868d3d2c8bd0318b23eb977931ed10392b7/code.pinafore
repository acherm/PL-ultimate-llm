# Simple Pinafore example showing entity creation
let
    # Create a new entity
    person = NewEntity;

    # Set properties on the entity
    person.Name := "Alice";
    person.Age := 30;

    # Retrieve and display the properties
    name = person.Name;
    age = person.Age;
in
    output "Name: " <> name <> ", Age: " <> IntegerToText age
