* SIMPLE HARMONIC OSCILLATOR
* This program simulates a mass-spring system
TITLE SIMPLE HARMONIC OSCILLATOR
PARAM M=1.0, K=4.0, B=0.1
INCON X=1.0, V=0.0
* Equations of motion
ACCEL = -(K/M)*X - (B/M)*V
V = INTGRL(0.0, ACCEL)
X = INTGRL(1.0, V)
* Output
PRTPLT X, V
TIMER FINTIM=10.0, DELT=0.01
END
STOP
ENDJOB
