PARTNO APT SAMPLE PROGRAM
MACHIN/MILL,1
CLPRNT
UNITS/INCHES

P1 = POINT/0,0,0
P2 = POINT/4,0,0
P3 = POINT/4,3,0
P4 = POINT/0,3,0

L1 = LINE/P1,P2
L2 = LINE/P2,P3
L3 = LINE/P3,P4
L4 = LINE/P4,P1

FROM/SETPT
SPINDL/1000,CLW
COOLNT/ON
FEDRAT/10

GO/TO,L1,TO,L4
GORGT/L1,PAST,L2
GORGT/L2,PAST,L3
GORGT/L3,PAST,L4
GORGT/L4,PAST,L1

COOLNT/OFF
SPINDL/OFF
GOTO/SETPT
FINI
