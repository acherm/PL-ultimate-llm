<MvCOMMENT>
Simple Hello World example in Miva Script
</MvCOMMENT>

<MvASSIGN NAME="l.message" VALUE="Hello, World!">
<MvEVAL EXPR="{ l.message }">

<MvCOMMENT>
Loop example to demonstrate control structures
</MvCOMMENT>

<MvASSIGN NAME="l.count" VALUE="1">
<MvWHILE EXPR="{ l.count LE 5 }">
    <MvEVAL EXPR="{ 'Count: ' $ l.count }">
    <MvASSIGN NAME="l.count" VALUE="{ l.count + 1 }">
</MvWHILE>
