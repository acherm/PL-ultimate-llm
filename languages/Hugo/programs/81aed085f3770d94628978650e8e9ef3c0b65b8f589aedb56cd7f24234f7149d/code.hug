!::
! A simple Hugo program
!::

#include "hugolib.h"

routine main
{
    color TEXTCOLOR, BGCOLOR
    cls

    "Welcome to Hugo!"
    print ""
    print "This is a simple interactive fiction program."
    print ""

    local name
    print "What is your name? ";
    input name

    if name = ""
        name = "Adventurer"

    print ""
    print "Hello, "; name; "!"
    print "Thanks for trying Hugo."
}