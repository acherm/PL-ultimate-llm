define turn_right {
    turnleft
    turnleft
    turnleft
}

define climb_step {
    turn_right
    move
    turnleft
    move
}

define descend_step {
    turn_right
    move
    turn_right
    move
    turnleft
    turnleft
}

do 3 times {
    climb_step
}

do 3 times {
    move
}

do 3 times {
    descend_step
}

turnoff
