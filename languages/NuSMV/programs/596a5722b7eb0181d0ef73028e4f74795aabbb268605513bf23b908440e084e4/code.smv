MODULE main
VAR
  request : boolean;
  state : {ready, busy};

ASSIGN
  init(state) := ready;
  next(state) :=
    case
      state = ready & request : busy;
      state = busy & !request : ready;
      TRUE : state;
    esac;

SPEC AG(request -> AF state = busy)
SPEC AG(state = busy -> EF state = ready)
