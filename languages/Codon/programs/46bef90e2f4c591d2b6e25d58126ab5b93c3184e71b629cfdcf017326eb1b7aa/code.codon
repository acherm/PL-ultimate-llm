from sys import argv

def fib(n: int) -> int:
    if n <= 1:
        return n
    a, b = 0, 1
    for _ in range(2, n + 1):
        a, b = b, a + b
    return b

def main():
    n = 20
    if len(argv) > 1:
        n = int(argv[1])
    for i in range(n):
        print(f"fib({i}) = {fib(i)}")

main()
