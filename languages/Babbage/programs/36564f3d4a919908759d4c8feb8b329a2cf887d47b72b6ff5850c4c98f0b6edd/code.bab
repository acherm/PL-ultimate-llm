BEGIN
   INTEGER N, FACT;
   
   PROCEDURE FACTORIAL(X);
      VALUE X;
      INTEGER X;
   BEGIN
      INTEGER I, RESULT;
      RESULT := 1;
      FOR I := 1 STEP 1 UNTIL X DO
         RESULT := RESULT * I;
      FACTORIAL := RESULT;
   END FACTORIAL;
   
   N := 5;
   FACT := FACTORIAL(N);
   PRINT(N, FACT);
END
