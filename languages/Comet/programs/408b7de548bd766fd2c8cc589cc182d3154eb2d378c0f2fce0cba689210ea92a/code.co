import cotfd;

int n = 8;
Solver<CP> m();
var<CP>{int} queen[1..n](m, 1..n);

m.post(alldifferent(queen));
m.post(alldifferent(all(i in 1..n) queen[i] + i));
m.post(alldifferent(all(i in 1..n) queen[i] - i));

solve<m> {
  forall(i in 1..n by 2)
    m.label(queen[i]);
  forall(i in 2..n by 2)
    m.label(queen[i]);
}

forall(i in 1..n)
  cout << queen[i] << " ";
cout << endl;
