class Shape {
    var color;

    def $init(color) {
        self.color = color;
    }

    pub def info() {
        $println("color: {}", self.color);
    }
}

class Circle extends Shape {
    var radius;

    def $init(color, radius) {
        super:$init(color);
        self.radius = radius;
    }

    pub def info() {
        super:info();
        $println("radius: {}", self.radius);
    }
}

var c = Circle("red", 10);
c:info();
