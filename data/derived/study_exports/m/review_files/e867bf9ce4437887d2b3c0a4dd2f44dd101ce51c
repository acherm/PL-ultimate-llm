  [communicator requestFilesUpload:fileUploadInfos
                      workspaceUid:workspaceUid
                      limitReached:limitReachedBlock
             singleUploadCompleted:nil
                      errorHandler:nil];
}

-(OBProtein *)protein:(OBProtein *)p replacingTransactionID:(NSInteger)ix
{
  NSMutableArray *descrips = [NSMutableArray arrayWithArray:p.descrips];
  NSInteger index = [descrips indexOfObject:@"to:"];
  id provAndId = descrips[index+1];
  if ([provAndId isKindOfClass:[NSArray class]] && [provAndId count] > 1)
  {
    NSArray *newProvAndId= @[provAndId[0], [NSNumber numberWithInteger:ix]];
    [descrips replaceObjectAtIndex:index+1 withObject:newProvAndId];
  }
  p.descrips = descrips;
  return p;
}

-(void) testRequestImageFileBatchUploadAllAccepted
{
  [self setUpConnectedCommunicator_v2_12];

  NSInteger numberOfFiles = 3;
  [self prepareFileBatchUploadTransactionForAssetUploadTests:numberOfFiles limitReach:nil];

  STAssertTrue([[communicator pendingFileUploads] count] == numberOfFiles, @"Pending file upload should be %d, instead got %d", numberOfFiles, [[communicator pendingFileUploads] count]);

  NSString *key = [proteinSource proteinKeyForTransactionName:MZTransactionNameAssetUploadProvision responseType:@"response?all-images-fit"];
  OBProtein *p = [proteinSource proteinForKey:key];
  NSInteger sentProteinCountBeforeRequest = requestPoolConnector.sentProteins.count;
  p = [self protein:p replacingTransactionID:sentProteinCountBeforeRequest];
  [responsePoolConnector receivedProtein:p];

  STAssertTrue([[communicator pendingFileUploads] count] == 0, @"No pending file uploads should be present before we start");

  NSLog(@"Number of uploads in progress %lu", (unsigned long)[communicator progressiveTransactions].count);

  STAssertTrue([communicator progressiveTransactions].count == 1, @"Progressive upload transactions should be %d, instead got %d", 1, [[communicator progressiveTransactions] count]);

  [NSThread sleepForTimeInterval:3.0];

  MZFileBatchUploadRequestTransaction *progressiveTransaction = [communicator progressiveTransactions][0];

  STAssertTrue(progressiveTransaction.transactionsInProgress.count == numberOfFiles, @"Transactions in progress should be %d, instead got %d", numberOfFiles, progressiveTransaction.transactionsInProgress.count);

  for (NSInteger i = 0 ; i < numberOfFiles; i++)
  {
    NSString *responseType = [NSString stringWithFormat:@"psa?image-asset-%ld", (long)i+1];
    NSString *key = [proteinSource proteinKeyForTransactionName:MZTransactionNameAssetRefresh responseType:responseType];
    OBProtein *p = [proteinSource proteinForKey:key];
    [responsePoolConnector receivedProtein:p];

    STAssertTrue(progressiveTransaction.transactionsInProgress.count == numberOfFiles-1-i, @"Transactions in progress should be %d, instead got %d", numberOfFiles-1-i, progressiveTransaction.transactionsInProgress.count);
  }

  STAssertTrue([communicator progressiveTransactions].count == 0, @"Progressive upload transactions should be %d, instead got %d", 0, [[communicator progressiveTransactions] count]);

  STAssertTrue([communicator pendingTransactions].count == 0, @"Pending transactions should be %d, instead got %d", 0, [[communicator pendingTransactions] count]);
}

-(void) testRequestImageFileBatchUploadSomeAccepted
