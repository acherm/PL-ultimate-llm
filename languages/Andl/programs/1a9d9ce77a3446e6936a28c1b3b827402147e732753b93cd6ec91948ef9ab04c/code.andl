// Define a supplier table
Supplier := {{
  (S := 'S1', Sname := 'Smith', Status := 20, City := 'London'),
  (S := 'S2', Sname := 'Jones', Status := 10, City := 'Paris'),
  (S := 'S3', Sname := 'Blake', Status := 30, City := 'Paris')
}}

// Query: Find suppliers in Paris
Supplier [City = 'Paris'] { S, Sname }