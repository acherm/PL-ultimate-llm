// DRAKON Factorial Calculator
// A simple implementation of factorial using DRAKON Editor

function factorial(n)
var result = 1
var i = 1
while i <= n
    result = result * i
    i = i + 1
endwhile
return result
end

// Main program
var number = 5
var answer = factorial(number)
print("Factorial of " + number + " is " + answer)