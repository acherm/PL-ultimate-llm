class Person
{
public:
    name: String;
    age: Integer;

    create(pName: String; pAge: Integer): Person;
    begin
        self.name := pName;
        self.age := pAge;
        return self;
    end;

    display();
    begin
        write "Name: " & self.name;
        write "Age: " & self.age.String;
    end;
}