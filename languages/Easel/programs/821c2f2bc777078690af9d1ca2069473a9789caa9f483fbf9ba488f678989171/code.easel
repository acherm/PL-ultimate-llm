PROGRAM CustomerMenu

PROCEDURE DisplayMenu
  CLEAR SCREEN
  DISPLAY "Customer Management System"
  DISPLAY "1. Add Customer"
  DISPLAY "2. View Customers"
  DISPLAY "3. Delete Customer"
  DISPLAY "4. Exit"
  DISPLAY "Enter choice: "
END PROCEDURE

PROCEDURE Main
  DECLARE choice AS INTEGER

  LOOP
    CALL DisplayMenu
    INPUT choice

    IF choice = 1 THEN
      DISPLAY "Adding customer..."
    ELSE IF choice = 2 THEN
      DISPLAY "Viewing customers..."
    ELSE IF choice = 3 THEN
      DISPLAY "Deleting customer..."
    ELSE IF choice = 4 THEN
      DISPLAY "Exiting..."
      EXIT LOOP
    ELSE
      DISPLAY "Invalid choice!"
    END IF
  END LOOP
END PROCEDURE

CALL Main

END PROGRAM
