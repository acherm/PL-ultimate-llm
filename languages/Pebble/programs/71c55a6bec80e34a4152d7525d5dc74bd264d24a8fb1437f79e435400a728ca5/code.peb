{% extends "base.html" %}

{% block title %}{{ page.title }}{% endblock %}

{% block content %}
    <h1>{{ greeting }}</h1>
    <ul>
    {% for user in users %}
        <li>{{ user.name }} - {{ user.email }}</li>
    {% endfor %}
    </ul>
    
    {% if users is empty %}
        <p>No users found.</p>
    {% endif %}
{% endblock %}