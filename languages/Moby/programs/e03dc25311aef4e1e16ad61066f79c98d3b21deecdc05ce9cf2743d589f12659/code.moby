(* Fibonacci sequence in Moby *)

fun fib (n : int) : int =
  if (n <= 1)
    then n
    else fib (n-1) + fib (n-2)

fun loop (i : int, limit : int) =
  if (i < limit)
    then (
      print ("fib(" ^ Int.toString(i) ^ ") = " ^ Int.toString(fib(i)) ^ "\n");
      loop (i+1, limit)
    )
    else ()

val () = loop (0, 10)
