MODULE Counter;
  INTERFACE
    PROCEDURE Increment();
    PROCEDURE GetValue(): INTEGER;
  END;

  VAR count: INTEGER;

  BODY
    count := 0;

    PROCEDURE Increment();
    BEGIN
      count := count + 1;
    END Increment;

    PROCEDURE GetValue(): INTEGER;
    BEGIN
      RETURN count;
    END GetValue;
  END;
END Counter.
