begin
    integer n, result;

    integer function factorial(integer x);
    begin
        if x <= 1 then
            factorial := 1
        else
            factorial := x * factorial(x - 1)
    end;

    n := 5;
    result := factorial(n);
    printstring("Factorial of ");
    printinteger(n);
    printstring(" is ");
    printinteger(result);
    newline
end