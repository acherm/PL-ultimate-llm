(* Fibonacci sequence in Delight *)
(* Delight - a systems programming language by Paul Andreae *)

module Fibonacci;

function Fib(n: int): int;
begin
  if n < 2 then
    Fib := n
  else
    Fib := Fib(n - 1) + Fib(n - 2)
  end if
end Fib;

procedure Main;
  var i: int;
begin
  for i := 0 to 10 do
    writeln(Fib(i))
  end for
end Main;

end Fibonacci.
