// FizzBuzz in Amber
// Prints numbers 1-30, replacing multiples of 3 with "Fizz",
// multiples of 5 with "Buzz", and multiples of both with "FizzBuzz"

main {
    loop i in 1..31 {
        if i % 15 == 0 {
            echo "FizzBuzz"
        } else if i % 3 == 0 {
            echo "Fizz"
        } else if i % 5 == 0 {
            echo "Buzz"
        } else {
            echo "{i}"
        }
    }
}
