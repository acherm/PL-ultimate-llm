# Simple 8-bit processor specification in SLEIGH

define endian=little;
define alignment=1;

define space ram type=ram_space size=2 default;
define space register type=register_space size=1;

define register offset=0x00 size=1 [ A X Y ];
define register offset=0x10 size=2 [ PC SP ];

define token opbyte (8)
   op=(0,7)
   reg=(0,2)
;

:NOP is op=0x00 {
}

:LDA reg is op=0x10 & reg {
   A = reg;
}

:STA reg is op=0x20 & reg {
   reg = A;
}
