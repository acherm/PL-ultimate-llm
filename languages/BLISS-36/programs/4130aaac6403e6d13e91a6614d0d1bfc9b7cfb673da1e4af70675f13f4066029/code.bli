MODULE FACTORIAL =
BEGIN

FORWARD ROUTINE
    FACT : NOVALUE;

ROUTINE FACT (N) =
BEGIN
    LOCAL RESULT;
    IF .N LEQ 1
    THEN RESULT = 1
    ELSE RESULT = .N * FACT(.N - 1);
    RETURN .RESULT
END;

ROUTINE MAIN : NOVALUE =
BEGIN
    LOCAL I;
    INCR I FROM 1 TO 10 DO
        $PRINT('Factorial of ', .I, ' is ', FACT(.I))
END;

END
ELUDOM
