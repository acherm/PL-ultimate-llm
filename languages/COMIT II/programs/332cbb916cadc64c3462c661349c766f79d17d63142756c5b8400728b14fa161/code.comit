* COMIT II String Reversal Program
* This program reverses a string character by character
START
  READ $INPUT
  SET $OUTPUT = ''
LOOP
  IF $INPUT = '' THEN GOTO DONE
  SET $CHAR = LEFT($INPUT, 1)
  SET $INPUT = RIGHT($INPUT, LEN($INPUT) - 1)
  SET $OUTPUT = $CHAR + $OUTPUT
  GOTO LOOP
DONE
  PRINT $OUTPUT
  END