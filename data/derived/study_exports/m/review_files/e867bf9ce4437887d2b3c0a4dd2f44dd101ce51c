#pragma mark - Assets Tests

-(void) testRequestFileUpload
{
  [self setUpConnectedCommunicator_v2_12];
  
  NSString *workspaceUid = [proteinSource parameterForKey:kCanonicalParameterWorkspaceUidKey];

  NSURL *fileURL = [NSURL fileURLWithPath:@"/temp/someimage.jpg"];
  NSString *fileType = @"image/jpeg";
  MZFileUploadInfo *uploadInfo = [[MZFileUploadInfo alloc] init];
  uploadInfo.fileURL = fileURL;
  uploadInfo.fileName = [fileURL lastPathComponent];
  uploadInfo.format = fileType;

  NSInteger sentProteinCountBeforeRequest = requestPoolConnector.sentProteins.count;

  STAssertTrue([[communicator pendingFileUploads] count] == 0, @"No pending file uploads should be present before we start");

  [communicator requestFilesUpload:@[uploadInfo]
                      workspaceUid:workspaceUid
                      limitReached:nil
             singleUploadCompleted:nil
                      errorHandler:nil];
  
  STAssertTrue([[communicator pendingFileUploads] count] == 1, @"One pending file upload should be present.");
  id fileInfo = [communicator pendingFileUploads][0];

  STAssertTrue([fileInfo isKindOfClass:[MZFileUploadInfo class]], @"As of 2.12 the pendingFilesUploads array should contain instances of MZFileUploadInfo.");

  STAssertNotNil([fileInfo fileUid], @"File id should be set");
  STAssertEqualObjects([fileInfo fileURL], fileURL, @"File url should equal.");
  STAssertEqualObjects([fileInfo format], fileType, @"File types should equal.");
  
  STAssertTrue(requestPoolConnector.sentProteins.count == sentProteinCountBeforeRequest+1, @"One protein should've been sent.");
  if (requestPoolConnector.sentProteins.count == 1)
  {
    OBProtein *sentProtein = requestPoolConnector.sentProteins[0];
    STAssertTrue([sentProtein containsDescrip:MZTransactionNameAssetUploadProvision], @"Send protein should be of transaction type '%@'", MZTransactionNameAssetUploadProvision);
  }
}


-(void) testRequestFileUploadBatch
{
  [self setUpConnectedCommunicator_v2_12];

  NSString *workspaceUid = [proteinSource parameterForKey:kCanonicalParameterWorkspaceUidKey];

  NSMutableArray *fileInfos = [[NSMutableArray alloc] init];
  for (NSInteger i = 1 ; i <= 5 ; i++)
  {
    MZFileUploadInfo *uploadInfo = [[MZFileUploadInfo alloc] init];
    uploadInfo.fileName = [NSString stringWithFormat:@"image%ld.jpg",(long)i];
    uploadInfo.format = @"png";
    uploadInfo.imageBlock = ^{
      NSBundle *bundle = [NSBundle bundleForClass:[self class]];
      NSString *path = [bundle pathForResource:@"Test-Image" ofType:@"png"];
      MZImage *image = [[MZImage alloc] initWithContentsOfFile:path];
      return image;
    };
    [fileInfos addObject:uploadInfo];
  }

  NSInteger numberOfFiles = fileInfos.count;


  STAssertTrue([[communicator pendingFileUploads] count] == 0, @"No pending file uploads should be present before we start");

  [communicator requestFilesUpload:fileInfos
                      workspaceUid:workspaceUid
                      limitReached:nil
             singleUploadCompleted:nil
                      errorHandler:nil];

  STAssertTrue([[communicator pendingFileUploads] count] == numberOfFiles, @"Pending file upload should be %d, instead got %d", numberOfFiles, [[communicator pendingFileUploads] count]);
  if (requestPoolConnector.sentProteins.count > 0)
  {
    OBProtein *lastProtein = requestPoolConnector.sentProteins[requestPoolConnector.sentProteins.count-1];
    
    NSArray *files = lastProtein.ingests[@"files"];
    STAssertTrue(files.count == fileInfos.count, @"Number of files in protein should be 5", numberOfFiles);
  }
}

