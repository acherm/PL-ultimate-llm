"Bistro: Fibonacci sequence"

class Fibonacci extends Object
[
    fib: n Integer -> Integer [
        n <= 1 ifTrue: [ ^n ].
        ^(self fib: n - 1) + (self fib: n - 2)
    ]

    main: String[] args [
        0 to: 9 do: [ :i |
            Transcript
                show: 'F(' , i printString , ') = ' , (self fib: i) printString;
                nl
        ]
    ]
]
