API description HelloWorldAPI
usage context PUBLIC_API for FRONTEND_INTEGRATION

endpoint type HelloWorldFacade
  exposes
    operation sayHello
      expecting
        payload "name": D<string>
      delivering
        payload "greeting": D<string>

    operation getGreetingCount
      delivering
        payload "count": D<int>

data type GreetingRecord {
  "name": D<string>,
  "greeting": D<string>,
  "timestamp": D<string>
}
