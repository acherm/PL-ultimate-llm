COMPOOL NAVIGATION_DATA;

  ITEM POSITION:
    ITEM LATITUDE  F,2;
    ITEM LONGITUDE F,2;
    ITEM ALTITUDE  F,2;
  TERM;

  ITEM VELOCITY:
    ITEM SPEED     F,2;
    ITEM HEADING   F,2;
    ITEM CLIMB_RATE F,2;
  TERM;

  ITEM TIMESTAMP S,1;

  TABLE WAYPOINTS(100):
    ITEM WAYPOINT_ID S,1;
    ITEM WAYPOINT_POS POSITION;
  TERM;

END COMPOOL;
