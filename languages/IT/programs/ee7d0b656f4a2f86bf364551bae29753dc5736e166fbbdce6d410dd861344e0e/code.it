C PROGRAM TO COMPUTE QUADRATIC FORMULA
C ROOT = (-B + SQRT(B*B - 4*A*C)) / (2*A)
      READ A, B, C
      D = B*B - 4.0*A*C
      IF (D) 10, 20, 20
10    PRINT "NO REAL ROOTS"
      STOP
20    CONTINUE
      SQRTD = SQRT(D)
      ROOT1 = (-B + SQRTD) / (2.0*A)
      ROOT2 = (-B - SQRTD) / (2.0*A)
      PRINT ROOT1, ROOT2
      STOP
      END
