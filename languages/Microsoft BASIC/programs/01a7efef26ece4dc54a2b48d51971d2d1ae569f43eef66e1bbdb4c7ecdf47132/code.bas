10 REM BUBBLE SORT IN MICROSOFT BASIC
20 DIM A(10)
30 FOR I = 1 TO 10
40   READ A(I)
50 NEXT I
60 DATA 64, 25, 12, 22, 11, 90, 35, 47, 8, 3
70 REM BUBBLE SORT
80 FOR I = 1 TO 9
90   FOR J = 1 TO 10 - I
100    IF A(J) <= A(J+1) THEN GOTO 140
110    LET T = A(J)
120    LET A(J) = A(J+1)
130    LET A(J+1) = T
140  NEXT J
150 NEXT I
160 PRINT "SORTED ARRAY:"
170 FOR I = 1 TO 10
180   PRINT A(I);
190 NEXT I
200 PRINT
210 END
