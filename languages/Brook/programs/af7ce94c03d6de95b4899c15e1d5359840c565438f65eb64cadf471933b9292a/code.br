// Vector addition kernel in Brook
kernel void vecadd(float a<>, float b<>, out float result<>) {
    result = a + b;
}

int main() {
    float a<100>;
    float b<100>;
    float result<100>;

    // Initialize streams
    for (int i = 0; i < 100; i++) {
        a[i] = (float)i;
        b[i] = (float)i * 2.0f;
    }

    // Run kernel
    vecadd(a, b, result);

    streamPrint(result);

    return 0;
}
