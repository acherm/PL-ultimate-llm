int factorial(int n)
{
  decl
    int result;
  enddecl
  begin
    if (n <= 1) then
      result = 1;
    else
      result = n * factorial(n - 1);
    endif;
    return result;
  end
}

int main()
{
  decl
    int num, fact;
  enddecl
  begin
    num = 5;
    fact = factorial(num);
    write(fact);
    return 0;
  end
}
