package main

object Program
    func run {
        var n = 10;
        Out println: "Fibonacci sequence:";
        for i in 0 .. n {
            Out println: (fibonacci: i)
        }
    }

    func fibonacci: (Int n) -> Int {
        if n <= 1 {
            return n
        } else {
            return (fibonacci: n - 1) + (fibonacci: n - 2)
        }
    }
end
