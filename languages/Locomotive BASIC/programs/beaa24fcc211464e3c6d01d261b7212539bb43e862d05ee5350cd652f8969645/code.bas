10 MODE 1
20 INK 0,0: INK 1,26: BORDER 0
30 CLS
40 PRINT "Locomotive BASIC Demo"
50 PRINT
60 FOR I=1 TO 200 STEP 5
70 PLOT I,I,1
80 DRAW I+50,I
90 DRAW I+50,I+50
100 DRAW I,I+50
110 DRAW I,I
120 NEXT I
130 LOCATE 10,15
140 PRINT "Press any key"
150 CALL &BB18
160 CLS
170 PRINT "Fibonacci sequence:"
180 A=0: B=1
190 FOR I=1 TO 10
200 PRINT A;
210 C=A+B
220 A=B
230 B=C
240 NEXT I
250 END
