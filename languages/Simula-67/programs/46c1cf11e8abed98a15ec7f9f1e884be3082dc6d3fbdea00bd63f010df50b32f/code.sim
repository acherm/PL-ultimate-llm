BEGIN
   INTEGER PROCEDURE Fibonacci(n);
      INTEGER n;
   BEGIN
      IF n < 2 THEN
         Fibonacci := n
      ELSE
         Fibonacci := Fibonacci(n-1) + Fibonacci(n-2)
   END Fibonacci;

   INTEGER i;
   FOR i := 0 STEP 1 UNTIL 10 DO BEGIN
      OutInt(Fibonacci(i), 0);
      OutChar(' ')
   END;
   OutImage
END.