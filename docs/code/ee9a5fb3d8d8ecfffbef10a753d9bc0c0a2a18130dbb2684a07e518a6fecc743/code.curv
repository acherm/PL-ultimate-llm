// Koch Snowflake
// Doug Moen, 10/6/17

fn koch(n) {
    if (n == 0) {
        translate <0.5,0> rotate 60 deg scale 1/3 box ;
    } else {
        translate <0.5,0> rotate 60 deg scale 1/3 koch (n-1) ;
        koch (n-1) ;
    }
} ;

let snowflake = loop 3 times {
    translate <0.5,0> rotate 120 deg koch 4 ;
} ;

translate <-0.5,0> snowflake ;