@version 2.2
@warnings

// Bubble sort implementation in LScript for LightWave 3D
generic
{
    integer arr[];
    integer i, j, temp, n;

    arr[1] = 64;
    arr[2] = 34;
    arr[3] = 25;
    arr[4] = 12;
    arr[5] = 22;
    arr[6] = 11;
    arr[7] = 90;
    n = 7;

    for (i = 1; i <= n - 1; i++)
    {
        for (j = 1; j <= n - i; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    info("Sorted array:");
    for (i = 1; i <= n; i++)
    {
        info(arr[i]);
    }
}
