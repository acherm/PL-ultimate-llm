stef fib(n : heiltala) : heiltala;
stofn
    ef n < 2 þá
        skila n
    annars
        skila fib(n - 1) + fib(n - 2)
    loka ef
loka stef;

stef main();
stofn
    breyta i : heiltala;
    i := 0;
    medan i < 10 gera
        skrifa(fib(i), " ");
        i := i + 1
    loka medan;
    skrifa("\n")
loka stef;
