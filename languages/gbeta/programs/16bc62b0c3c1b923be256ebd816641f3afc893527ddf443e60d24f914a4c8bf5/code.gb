(#
   person:
     (# name: @string;
        age: @integer;
        greet:
          (#
          do 'Hello, my name is ' -> puttext;
             name -> puttext;
             ' and I am ' -> puttext;
             age -> putint;
             ' years old.' -> putline
          #)
     #);
   p: @person
do
   'Alice' -> p.name;
   30 -> p.age;
   p.greet
#)