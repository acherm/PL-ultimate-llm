; Hello, World! in BFASM
; BFASM - Brainfuck macro assembler by Kamila Szewczyk
; Outputs a greeting using ASCII values stored in data section

%macro print_char 1
    [-]        ; zero current cell
    %rep %1
        +      ; increment to target ASCII value
    %endrep
    .          ; output character
%endmacro

; Print 'H' (72), 'i' (105), '!' (33), newline (10)
>>>>
; H
[-]++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++.
; i
[-]+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++.
; !
[-]+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++.

; newline
[-]++++++++++.
