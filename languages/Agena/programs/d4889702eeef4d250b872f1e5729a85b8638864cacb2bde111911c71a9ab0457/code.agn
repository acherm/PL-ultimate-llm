# Fibonacci sequence generator in Agena
fibonacci := proc(n) is
    local a, b, temp, i;
    if n <= 0 then
        return 0;
    elif n == 1 then
        return 1;
    else
        a := 0;
        b := 1;
        for i from 2 to n do
            temp := a + b;
            a := b;
            b := temp;
        od;
        return b;
    fi;
end;

# Calculate and print first 10 Fibonacci numbers
for i from 0 to 9 do
    print(i, ": ", fibonacci(i));
od;
