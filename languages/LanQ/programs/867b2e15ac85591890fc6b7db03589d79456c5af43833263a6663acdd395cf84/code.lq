/* Quantum coin flip in LanQ
   Demonstrates quantum superposition via Hadamard gate
   Mlnarik, H. LanQ - a functional quantum programming language (2007) */

int coin_flip() {
    qbit q;
    q = new(0);
    H(q);
    int result = measure(q);
    return result;
}

int main() {
    int i;
    for (i = 0; i < 5; i++) {
        int r = coin_flip();
        print(r);
    }
    return 0;
}
