' {$STAMP BS2}
' {$PBASIC 2.5}
' LED Blink Program
' Blinks an LED connected to P13

DEBUG "LED Blink Program", CR

DO
  HIGH 13                ' Turn LED on
  PAUSE 500              ' Wait 500 milliseconds
  LOW 13                 ' Turn LED off
  PAUSE 500              ' Wait 500 milliseconds
LOOP
