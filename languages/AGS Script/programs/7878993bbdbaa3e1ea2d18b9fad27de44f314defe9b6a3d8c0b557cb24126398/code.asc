// Simple AGS Script demonstrating character interaction
// This script makes a character walk to a position and say something

function room_AfterFadeIn()
{
  // Make player character walk to the middle of the room
  cEgo.Walk(160, 100, eBlock, eWalkableAreas);
  cEgo.Say("I've arrived at my destination!");
  
  // Face the character in a specific direction
  cEgo.FaceDirection(eDirectionRight);
  Wait(40);
  
  // Unlock an achievement or trigger
  if (!Game.DoOnceOnly("first_room_entered"))
  {
    cEgo.Say("Wait, I've been here before...");
  }
}

function oObject_Interact()
{
  // Player interacts with an object
  cEgo.Walk(oObject.X, oObject.Y, eBlock, eWalkableAreas);
  cEgo.FaceObject(oObject);
  cEgo.Say("Let me examine this mysterious object.");
  
  // Play an animation
  oObject.Animate(1, 5, eOnce, eBlock);
  
  // Give item to player
  player.AddInventory(iKey);
  cEgo.Say("I found a key!");
}

function hHotspot_Look()
{
  // Player looks at a hotspot
  cEgo.Say("There's something interesting over there.");
  
  // Change room lighting
  SetAmbientTint(50, 50, 100, 30, 100);
}
