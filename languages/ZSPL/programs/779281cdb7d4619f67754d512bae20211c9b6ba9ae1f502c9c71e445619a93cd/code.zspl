MODULE SumArray;

(* Compute the sum of an array of words *)

DECLARE N    CONSTANT WORD := 8;
DECLARE Data(*) WORD := (3, 1, 4, 1, 5, 9, 2, 6);
DECLARE Total WORD;

PROCEDURE ArraySum(A(*) WORD; LEN WORD) WORD;
  DECLARE I   WORD;
  DECLARE Acc WORD;
  Acc := 0;
  FOR I := 0 TO LEN - 1 DO
    Acc := Acc + A(I);
  RETURN Acc;
END ArraySum;

Total := ArraySum(Data, N);

END SumArray;
