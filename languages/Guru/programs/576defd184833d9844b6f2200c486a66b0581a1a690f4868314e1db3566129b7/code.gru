-- Natural numbers in Guru
data Nat : type where
  zero : Nat
| succ : Nat -> Nat.

-- Addition function
fun plus : Nat -> Nat -> Nat where
  plus zero n = n
| plus (succ m) n = succ (plus m n).

-- Example: 2 + 3 = 5
def two : Nat = succ (succ zero).
def three : Nat = succ (succ (succ zero)).
def five : Nat = plus two three.
