(document :title "Introduction to Skribe"
   :author (author :name "Erick Gallesio"
                   :affiliation "INRIA")

   (chapter :title "Overview"
      (p "Skribe is a document authoring system that uses a Scheme-like
         syntax to produce documents in multiple output formats, including
         HTML, LaTeX, and PostScript.")

      (section :title "Features"
         (itemize
            (item (bold "Multiple output formats:") " HTML, LaTeX, PDF, PostScript")
            (item (bold "Programmable:") " full Scheme available in documents")
            (item (bold "Extensible:") " user-defined styles and packages")
            (item (bold "Bibliography:") " BibTeX-compatible reference management")))

      (section :title "Hello World"
         (p "The simplest Skribe document looks like this:")
         (prog
"(document :title \"Hello\"
   (p \"Hello, World!\"))")
         (p "Run it with: " (code "skribe --html hello.skr -o hello.html")))))
