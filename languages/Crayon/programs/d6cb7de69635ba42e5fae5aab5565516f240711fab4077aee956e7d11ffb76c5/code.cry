function main() {
    print("Hello, World!");
    
    // Fibonacci sequence
    list = [0, 1];
    for (i = 0; i < 10; i += 1) {
        next = list[list.length - 1] + list[list.length - 2];
        list.add(next);
    }
    
    print("Fibonacci sequence:");
    for (num : list) {
        print(num);
    }
}
