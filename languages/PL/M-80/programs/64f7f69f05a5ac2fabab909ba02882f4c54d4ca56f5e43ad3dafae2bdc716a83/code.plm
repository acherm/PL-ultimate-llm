/* HELLO WORLD PROGRAM IN PL/M-80 */
HELLO: DO;
   DECLARE BDOS LITERALLY '5';
   DECLARE CR LITERALLY '0DH';
   DECLARE LF LITERALLY '0AH';

   PRINT$STRING: PROCEDURE(STR);
      DECLARE STR ADDRESS;
      DECLARE (I, CH BASED STR) BYTE;
      I = 0;
      DO WHILE (CH := STR(I)) <> '$';
         CALL BDOS(2, CH);
         I = I + 1;
      END;
   END PRINT$STRING;

   CALL PRINT$STRING(.'HELLO, WORLD!$');
   CALL BDOS(2, CR);
   CALL BDOS(2, LF);
END HELLO;
