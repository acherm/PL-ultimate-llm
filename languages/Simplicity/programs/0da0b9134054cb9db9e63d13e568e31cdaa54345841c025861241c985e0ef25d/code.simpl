-- Simple identity function in Simplicity
-- Takes a unit value and returns it
iden : 1 |- 1
iden = iden

-- Pair construction example
pair : A * B |- A * B
pair = iden

-- Unit constant
unit : A |- 1
unit = unit

-- Simple addition with witness data
-- This checks a signature witness
witness : 1 |- 2^256
witness = witness
