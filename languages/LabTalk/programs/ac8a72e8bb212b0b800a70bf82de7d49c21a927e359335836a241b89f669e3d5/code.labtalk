// Fibonacci sequence in LabTalk (OriginLab scripting language)
// Demonstrates variables, for-loops, and string-formatted output

int n = 10;
double a = 0, b = 1, tmp;
int i;

type "Fibonacci sequence:";
for (i = 1; i <= n; i++) {
    type "F($(i)) = $(a)";
    tmp = a + b;
    a = b;
    b = tmp;
}
