(define factorial
  {number --> number}
  0 -> 1
  N -> (* N (factorial (- N 1))))

(define fibonacci
  {number --> number}
  0 -> 0
  1 -> 1
  N -> (+ (fibonacci (- N 1)) (fibonacci (- N 2))))

(output "Factorial of 5: ~A~%" (factorial 5))
(output "Fibonacci of 10: ~A~%" (fibonacci 10))
(output "Factorial of 10: ~A~%" (factorial 10))