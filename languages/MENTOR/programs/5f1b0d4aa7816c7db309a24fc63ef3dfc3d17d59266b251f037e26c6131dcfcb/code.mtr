PROGRAM SIMPLE_GRAPHICS;

BEGIN
  -- Initialize graphics display
  INIT_DISPLAY(640, 480);

  -- Draw a simple rectangle
  DRAW_RECTANGLE(100, 100, 300, 200);

  -- Draw a line
  DRAW_LINE(50, 50, 400, 400);

  -- Display text
  DRAW_TEXT(150, 250, "MENTOR Graphics");

  -- Wait for user input
  WAIT_KEY;

  -- Close display
  CLOSE_DISPLAY;
END;
