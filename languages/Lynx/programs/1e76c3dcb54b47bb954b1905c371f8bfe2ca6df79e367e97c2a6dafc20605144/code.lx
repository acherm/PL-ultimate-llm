module Fibonacci;

  function fib(n : integer) : integer;
  begin
    if n <= 1 then
      fib := n
    else
      fib := fib(n - 1) + fib(n - 2)
    end
  end;

  process Main;
  var
    i      : integer;
    result : integer;
  begin
    writeln("Fibonacci sequence:");
    for i := 0 to 9 do
      result := fib(i);
      write(result);
      if i < 9 then
        write(", ")
      end
    end;
    writeln
  end;

end Fibonacci.
