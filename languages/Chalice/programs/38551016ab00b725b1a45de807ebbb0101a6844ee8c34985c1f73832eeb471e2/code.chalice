class Cell {
  var x: int

  method init(v: int)
    requires acc(x)
    ensures acc(x) && x == v
  {
    x := v
  }

  method set(v: int)
    requires acc(x)
    ensures acc(x) && x == v
  {
    x := v
  }

  method get() returns (v: int)
    requires acc(x)
    ensures acc(x) && v == x
  {
    v := x
  }
}