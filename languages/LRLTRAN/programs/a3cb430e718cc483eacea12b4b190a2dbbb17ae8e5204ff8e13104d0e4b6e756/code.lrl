      PROGRAM QUADRATIC
      REAL A, B, C, X1, X2, DISC
      READ(5,10) A, B, C
   10 FORMAT(3F10.2)
      DISC = B*B - 4.0*A*C
      IF(DISC) 20,30,30
   20 WRITE(6,40)
      GO TO 50
   30 X1 = (-B + SQRT(DISC))/(2.0*A)
      X2 = (-B - SQRT(DISC))/(2.0*A)
      WRITE(6,45) X1, X2
      GO TO 50
   40 FORMAT(' NO REAL ROOTS')
   45 FORMAT(' ROOTS: ',F10.4,' AND ',F10.4)
   50 STOP
      END