app TodoApp {
  wasp: {
    version: "^0.11.0"
  },
  title: "Todo App"
}

route RootRoute { path: "/", to: MainPage }

page MainPage {
  component: import Main from "@client/MainPage.jsx"
}

query getTasks {
  fn: import { getTasks } from "@server/queries.js",
  entities: [Task]
}

entity Task {=psl
  id          Int     @id @default(autoincrement())
  description String
  isDone      Boolean @default(false)
psl=}
