$remainderTemplate = StringTemplate["\
#pragma once
#include \"`aname`_coefficients.hpp\"

template <typename T> class remainder_`aname` {
	static constexpr size_t NCOEFFS = `NCOEFFS`;
	static constexpr size_t NFUNCS = `NFUNCS`;
	static constexpr size_t NLETTERS = 26;
	
	enum class f_type { f, bc, one };

	using TC = std::complex<T>;
	using RCoeffsType = T(*)(const std::array<T,5>&, const std::array<T,NLETTERS>&);

	std::shared_ptr<FunctionsManager> f_manager;

	const std::array<std::pair<RCoeffsType, RCoeffsType>, NCOEFFS> coeff_basis;
	const std::array<std::vector<std::pair<f_type,int>>, NFUNCS> functions_basis;
	// {index of coefficient, index of function, matrix element}
	const std::array<std::tuple<size_t,size_t, T>, `NMATRIX`> m_matrix;

  public:
	remainder_`aname`();
	remainder_`aname`(std::shared_ptr<FunctionsManager>);
	
	TC eval(const std::array<T,5>&, int);
};

template <typename T> remainder_`aname`<T>::remainder_`aname`(std::shared_ptr<FunctionsManager> mng) : f_manager(mng),
	coeff_basis{
`coeffbasis`
	},

	functions_basis{
`funcbasis`
	},

	m_matrix{
`mmatrix`
	}
{}

template <typename T> remainder_`aname`<T>::remainder_`aname`() : remainder_`aname`(std::make_shared<FunctionsManager>()) {}

template <typename T> std::complex<T> remainder_`aname`<T>::eval(const std::array<T,5>& v_in, int str5) {
    using std::array;

    Kin<T> kin(v_in);

    array<T,NLETTERS> iW;
    for (size_t i = 0; i < NLETTERS; ++i) {
        iW[i] = 1/(kin.W[i].real());
    }
    {
        T d5 = kin.SqrtDelta.imag();
        d5*=d5;
        iW[NLETTERS-1] = (-1)/d5;
    }

    array<TC,NCOEFFS> coeffs;

    for (size_t i = 0; i < NCOEFFS; ++i) {
        T re = coeff_basis[i].first(v_in, iW);
        T im = coeff_basis[i].second(v_in, iW);
        
        coeffs[i] = re + (str5*im) * kin.SqrtDelta;
    }

    const auto& function_values = f_manager->eval(kin);
    array<TC,NFUNCS> functions_basis_values;

    for (size_t i = 0; i < NFUNCS; ++i) {
        TC c{1};
        for (const auto& el : functions_basis[i]) {
            switch (el.first) {
                case f_type::f:
                    c *= function_values.at(el.second);
                    break;
                case f_type::bc:
                    c *= bc<T>.at(el.second);
                    break;
                case f_type::one:
                    break;
            }
        }
        functions_basis_values[i] = std::move(c);
    }

    // Neumaier summation (for improved numerical stability) [doi:10.1002/zamm.19740540106]
    TC sum{0};
    TC c{0};
    for (const auto& mi : m_matrix) {
        using std::get;
        using std::abs;
        auto si = (coeffs.at(get<0>(mi)) * functions_basis_values.at(get<1>(mi)) * get<T>(mi));
        auto t = sum + si;
        if (abs(sum) >= abs(si)) {
            c += ((sum - t) + si);
        }
        else {
            c += ((si - t) + sum);
        }
        sum = t;
    }
    sum += c;
    return sum;
}
"
];

