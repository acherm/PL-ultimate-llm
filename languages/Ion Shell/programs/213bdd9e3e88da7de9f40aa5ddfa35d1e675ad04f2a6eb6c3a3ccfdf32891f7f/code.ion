#!/usr/bin/env ion

# Hello World and basic operations in Ion Shell

let name:str = "World"
echo "Hello, $name!"

# Array example
let fruits:array = [apple banana cherry]
for fruit in @fruits
    echo "Fruit: $fruit"
end

# Simple arithmetic
let x:int = 10
let y:int = 20
let sum:int = $(( x + y ))
echo "Sum: $sum"
