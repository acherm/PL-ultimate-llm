# Hello World in Dao
io.writeln( 'Hello, World!' )

# Fibonacci function
routine fibonacci( n: int ) => int
{
    if( n <= 1 ) return n
    return fibonacci( n - 1 ) + fibonacci( n - 2 )
}

# Print first 10 Fibonacci numbers
for( i = 0 : 10 ) {
    io.writef( "fibonacci(%d) = %d\n", i, fibonacci(i) )
}
