comment Factorial and list utilities in MLISP;

define factorial[n] =
   if n = 0 then 1
   else n * factorial[n - 1];

define fib[n] =
   if n leq 1 then n
   else fib[n - 1] + fib[n - 2];

define mylen[lst] =
   if null[lst] then 0
   else 1 + mylen[cdr[lst]];

comment Print results;
print[factorial[6]];
print[fib[10]];
print[mylen[quote[(a b c d e)]]];
