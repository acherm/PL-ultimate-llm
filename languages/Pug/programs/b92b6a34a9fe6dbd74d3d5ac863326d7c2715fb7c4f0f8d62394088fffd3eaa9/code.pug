doctype html
html(lang="en")
  head
    title= pageTitle
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
  body
    header
      h1= heading
      nav
        ul
          each item in navItems
            li
              a(href=item.url)= item.text
    main
      article
        h2 Welcome
        p.
          This is a simple Pug template demonstrating
          the basic syntax and features of the language.
        if showMessage
          p.message Success!
    footer
      p &copy; 2024
