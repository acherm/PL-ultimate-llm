package com.example.rules

rule "Check Adult"
    when
        $person : Person( age >= 18 )
    then
        $person.setStatus("adult");
        System.out.println($person.getName() + " is an adult");
end

rule "Apply Discount"
    when
        $order : Order( total > 100.0 )
    then
        $order.setDiscount(0.10);
        System.out.println("Applying 10% discount to order");
end

rule "Stock Alert"
    when
        $product : Product( stock < 10 )
    then
        System.out.println("Low stock alert for " + $product.getName());
        insert(new StockAlert($product));
end
