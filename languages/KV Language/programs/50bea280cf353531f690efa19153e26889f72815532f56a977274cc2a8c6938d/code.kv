<LoginScreen>:
    orientation: 'vertical'
    padding: 20
    spacing: 10

    Label:
        text: 'Welcome'
        font_size: 24
        size_hint_y: None
        height: 60

    TextInput:
        id: username
        hint_text: 'Username'
        size_hint_y: None
        height: 44

    TextInput:
        id: password
        hint_text: 'Password'
        password: True
        size_hint_y: None
        height: 44

    Button:
        text: 'Login'
        size_hint_y: None
        height: 48
        on_press: root.do_login(username.text, password.text)
