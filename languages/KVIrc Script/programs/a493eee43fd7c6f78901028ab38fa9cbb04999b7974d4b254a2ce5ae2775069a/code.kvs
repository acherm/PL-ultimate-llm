alias hello {
    echo "Hello from KVIrc Scripting Language!"
    echo "Nick: $me"
    echo "Server: $server"
    echo "KVIrc version: $version"
}

alias countdown {
    %n = $1
    while (%n > 0) {
        echo %n
        %n--
    }
    echo "Liftoff!"
}

alias greet {
    %target = $1
    if (%target == "") {
        echo "Usage: /greet <nick>"
        return
    }
    msg $channel Hello, %target! Welcome to $channel.
}
