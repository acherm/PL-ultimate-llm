// Bell state preparation in Scaffold
// Prepares the state |00⟩ + |11⟩

module bell_state (qbit q0, qbit q1) {
    // Apply Hadamard gate to first qubit
    H(q0);

    // Apply CNOT gate with q0 as control and q1 as target
    CNOT(q0, q1);
}

// Main scaffold module
scaffold main {
    qbit q[2];
    bell_state(q[0], q[1]);
}
