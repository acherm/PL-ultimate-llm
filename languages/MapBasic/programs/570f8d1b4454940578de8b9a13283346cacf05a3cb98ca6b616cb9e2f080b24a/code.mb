' MapBasic - Hello World and basic table operations
Include "mapbasic.def"

Sub Main
    ' Print a greeting
    Print "Hello, World! MapBasic is running."

    ' Demonstrate basic string operations
    Dim sCity As String
    Dim sCountry As String
    sCity = "London"
    sCountry = "United Kingdom"
    Print "City: " & sCity & ", Country: " & sCountry

    ' Demonstrate numeric operations
    Dim nTotal As Integer
    nTotal = 42
    Print "Answer: " & nTotal
End Sub
