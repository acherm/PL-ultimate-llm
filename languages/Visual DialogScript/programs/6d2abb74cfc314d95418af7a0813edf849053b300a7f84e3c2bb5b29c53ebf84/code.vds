DIALOG CREATE,MyDialog,-1,0,0,200,100
DIALOG ADD,TEXT,TEXT1,5,10,190,20,"Hello World"
DIALOG ADD,BUTTON,OK1,70,60,60,25,"OK"
DIALOG SHOW
WAIT EVENT
@LABEL EVLOOP
  IF @EVENT_TYPE() = CLICKED
    IF @EVENT_SOURCE() = OK1
      GOTO CLOSE
    END
  END
  WAIT EVENT
  GOTO EVLOOP
@LABEL CLOSE
DIALOG CLOSE
