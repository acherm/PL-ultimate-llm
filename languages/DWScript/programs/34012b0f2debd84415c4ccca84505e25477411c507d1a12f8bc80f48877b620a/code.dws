// Fibonacci sequence calculator in DWScript
var
  n, i: Integer;
  a, b, temp: Integer;

begin
  n := 10;
  a := 0;
  b := 1;

  PrintLn('First ' + IntToStr(n) + ' Fibonacci numbers:');
  PrintLn(IntToStr(a));

  for i := 1 to n - 1 do
  begin
    PrintLn(IntToStr(b));
    temp := a + b;
    a := b;
    b := temp;
  end;
end.
