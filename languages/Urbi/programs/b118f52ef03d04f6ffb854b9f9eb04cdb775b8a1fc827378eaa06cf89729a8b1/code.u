// Fibonacci sequence in urbiscript
// From Rosetta Code: https://rosettacode.org/wiki/Fibonacci_sequence#urbiscript

function fibonacci(n)
{
  if (n < 2)
    return n;
  var a = 0;
  var b = 1;
  for (var i = 2; i <= n; i++)
  {
    var c = a + b;
    a = b;
    b = c;
  };
  return b;
};

for (var i = 0; i <= 16; i++)
  echo("fibonacci(%d) = %d" % [i, fibonacci(i)]);
