C     MORTRAN EXAMPLE - FACTORIAL CALCULATION
      PROGRAM FACT
      INTEGER N, I, RESULT

      WRITE(6,100)
100   FORMAT(' ENTER A NUMBER: ')
      READ(5,*) N

      RESULT = 1
      <DO I = 1, N>
         RESULT = RESULT * I
      <ENDDO>

      WRITE(6,200) N, RESULT
200   FORMAT(' FACTORIAL OF ', I3, ' IS ', I10)

      END
