    }

    var y = myfunc1(111, 222)
    println(y)

    var m = 111
    var n = 222

    if m > n {
        var i = 555
        println(i)
    } elif m < n {
        var j = 666
        println(j)
    } else {
        var l = 777
        println(l)
    }

    var t = (1+2)*3
    println(t)

    var a = 0
