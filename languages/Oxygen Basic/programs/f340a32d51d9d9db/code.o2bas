'Fibonacci Sequence Generator
'Displays first 15 Fibonacci numbers

function fibonacci(n as long) as long
  if n <= 1 then
    return n
  else
    return fibonacci(n-1) + fibonacci(n-2)
  end if
end function

print "Fibonacci Sequence:"
print "==================="
for i = 0 to 14
  print "F(" i ") = " fibonacci(i)
next
