PROC hello:
LOCAL choice%
DO
    PRINT "OPL Demo Menu"
    PRINT "1. Say Hello"
    PRINT "2. Show Date"
    PRINT "3. Exit"
    PRINT ""
    INPUT "Choose option:", choice%
    IF choice% = 1
        PRINT "Hello, World!"
        GET
    ELSEIF choice% = 2
        PRINT "Date:", DATE$
        GET
    ENDIF
UNTIL choice% = 3
ENDP
