// KDL Package Configuration Example
package {
    name "my-package"
    version "1.2.3"
    authors "Jane Doe <jane@example.com>"
    license "MIT"
}

dependencies {
    http "0.1.0"
    logging "2.0.0" {
        features "async" "colors"
    }
}

build {
    target "x86_64-unknown-linux-gnu"
    release true
    optimization-level 3
}

metadata {
    description "A sample KDL configuration"
    keywords "config" "example" "kdl"
    homepage "https://example.com"
}
