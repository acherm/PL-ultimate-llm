<blocks app="Snap! 7.0" version="2">
    <block-definition s="draw square %'size'" type="command" category="custom">
        <header></header>
        <code></code>
        <inputs>
            <input type="%n">100</input>
        </inputs>
        <script>
            <block s="doRepeat">
                <l>4</l>
                <script>
                    <block s="forward">
                        <block var="size"/>
                    </block>
                    <block s="turn">
                        <l>90</l>
                    </block>
                </script>
            </block>
        </script>
    </block-definition>
    <script>
        <block s="doSetVar">
            <l>penSize</l>
            <l>3</l>
        </block>
        <custom-block s="draw square %n">
            <l>100</l>
        </custom-block>
    </script>
</blocks>
