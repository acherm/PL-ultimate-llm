/* Lefty: Fibonacci sequence demonstration */

function fibonacci (n) {
    if (n <= 1)
        return n;
    return fibonacci (n - 1) + fibonacci (n - 2);
}

function main () {
    local i;
    i = 0;
    while (i <= 10) {
        print (concat ('fib(', i, ') = ', fibonacci (i), '\n'));
        i = i + 1;
    }
}
