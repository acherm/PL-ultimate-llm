         IDENT    FACT
* FACTORIAL PROGRAM IN COMPASS
         START    BEGIN
BEGIN    SA1      A1        LOAD N INTO A1
         SA2      =1        INITIALIZE RESULT TO 1
LOOP     SA2      A1*A2     MULTIPLY
         SA1      A1-B1     DECREMENT COUNTER
         NZ       A1,LOOP   LOOP IF NOT ZERO
         SA7      A2        STORE RESULT
         RETURN   A7
         END
