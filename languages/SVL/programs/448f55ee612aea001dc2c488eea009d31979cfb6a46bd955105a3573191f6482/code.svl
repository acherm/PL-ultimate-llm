// Fibonacci sequence in SVL (Scientific Vector Language)
// Demonstrates recursive functions and iteration in MOE's built-in language

local function fib [n]
    if n <= 1 then
        return n;
    endif
    return fib [n - 1] + fib [n - 2];
endfunction

local i;
for i = 0, 9 loop
    write twrite ['fib({}) = {}\n', i, fib [i]];
endloop
