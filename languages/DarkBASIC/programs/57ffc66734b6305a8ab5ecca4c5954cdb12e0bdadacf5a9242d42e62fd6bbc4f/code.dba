rem Simple 3D Rotating Cube in DarkBASIC
rem Set up display
sync on
sync rate 60
autocam off

rem Create a cube object
make object cube 1, 10

rem Position camera
position camera 0, 0, -30

rem Main loop
do
   rem Rotate the cube
   rotate object 1, object angle x(1) + 1, object angle y(1) + 1, object angle z(1) + 1

   rem Update screen
   sync
loop
