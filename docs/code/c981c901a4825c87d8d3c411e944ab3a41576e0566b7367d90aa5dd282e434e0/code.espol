BEGIN
  INTEGER PROCEDURE FACTORIAL(N);
  VALUE N;
  INTEGER N;
  BEGIN
    INTEGER RESULT;
    IF N <= 1 THEN
      RESULT := 1
    ELSE
      RESULT := N * FACTORIAL(N - 1);
    FACTORIAL := RESULT
  END FACTORIAL;

  INTEGER I, FACT;
  FOR I := 1 STEP 1 UNTIL 10 DO
  BEGIN
    FACT := FACTORIAL(I);
    WRITE(I, FACT)
  END
END