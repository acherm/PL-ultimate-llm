// Fibonacci sequence using EOL (Epsilon Object Language)
operation fibonacci(n : Integer) : Integer {
  if (n <= 1) {
    return n;
  }
  return fibonacci(n - 1) + fibonacci(n - 2);
}

// Print first 15 Fibonacci numbers
for (i in Sequence{0..14}) {
  ('fibonacci(' + i + ') = ' + fibonacci(i)).println();
}
