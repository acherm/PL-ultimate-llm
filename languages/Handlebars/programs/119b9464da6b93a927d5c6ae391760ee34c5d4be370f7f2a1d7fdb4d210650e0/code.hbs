<div class="entry">
  <h1>{{title}}</h1>
  <div class="body">
    {{body}}
  </div>
  {{#if author}}
    <div class="author">
      Written by {{author.firstName}} {{author.lastName}}
    </div>
  {{/if}}
  {{#each comments}}
    <div class="comment">
      <p>{{text}}</p>
      <p>By {{author}} on {{date}}</p>
    </div>
  {{/each}}
</div>