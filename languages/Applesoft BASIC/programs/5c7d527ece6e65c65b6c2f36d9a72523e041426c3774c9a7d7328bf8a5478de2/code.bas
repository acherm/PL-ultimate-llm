10 REM SIEVE OF ERATOSTHENES
20 REM FIND PRIME NUMBERS UP TO 100
30 DIM F(100)
40 FOR I = 2 TO 100
50   F(I) = 1
60 NEXT I
70 FOR I = 2 TO 10
80   IF F(I) = 0 THEN GOTO 120
90   FOR J = I * I TO 100 STEP I
100    F(J) = 0
110  NEXT J
120 NEXT I
130 PRINT "PRIME NUMBERS UP TO 100:"
140 FOR I = 2 TO 100
150   IF F(I) = 1 THEN PRINT I;" ";
160 NEXT I
170 PRINT
180 END
