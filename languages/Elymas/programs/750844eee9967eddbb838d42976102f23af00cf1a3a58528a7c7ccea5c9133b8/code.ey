# Fibonacci sequence in Elymas
# Takes a number from the stack and prints Fibonacci sequence

[ # function to calculate fibonacci
  [ dup 2 lt ] # base case: n < 2
  [  ] # return n itself
  [ # recursive case
    dup 1 - fib
    swap 2 - fib
    +
  ]
  if
] 'fib def

# Print first 10 Fibonacci numbers
0 10 (
  dup fib say
  1 +
) loop
