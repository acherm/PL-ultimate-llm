DATA:
n is number
a is number
b is number
temp is number
i is number

PROCEDURE:
display "How many Fibonacci numbers? " crlf
store 10 in n
store 0 in a
store 1 in b
store 0 in i
sub-procedure fib-loop
    if i is greater than or equal to n then
        return
    end if
    display a crlf
    store b in temp
    add a and b in b
    store temp in a
    add 1 and i in i
    go to fib-loop
end sub-procedure
