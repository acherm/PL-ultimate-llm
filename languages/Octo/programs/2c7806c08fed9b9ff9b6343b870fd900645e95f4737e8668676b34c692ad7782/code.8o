# Simple digit counter in Octo
# Counts 0-9 repeatedly, displayed on screen

: wait
    v3 := 10
    delay := v3
    loop
        v3 := delay
        while v3 != 0
    again
;

: main
    v0 := 0

    loop
        clear
        v1 := 28
        v2 := 12
        i := hex v0
        sprite v1 v2 5
        v0 += 1
        if v0 == 10 then v0 := 0
        wait
    again
