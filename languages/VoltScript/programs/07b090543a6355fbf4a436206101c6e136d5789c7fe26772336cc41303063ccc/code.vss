' VoltScript Fibonacci sequence example
Sub Main()
    Dim iCount As Integer
    Dim iA As Long
    Dim iB As Long
    Dim iTemp As Long
    Dim i As Integer

    iCount = 10
    iA = 0
    iB = 1

    Print "Fibonacci sequence (first " & CStr(iCount) & " numbers):"

    For i = 1 To iCount
        Print CStr(iA)
        iTemp = iA + iB
        iA = iB
        iB = iTemp
    Next i

End Sub
