class Counter {
    private int count;

    public Counter() {
        count = 0;
    }

    public void increment() {
        count = count + 1;
    }

    public int getValue() {
        return count;
    }
}

class Main {
    public static void main(String[] args) {
        Counter c = new Counter();
        c.increment();
        c.increment();
        System.out.println(c.getValue());
    }
}
