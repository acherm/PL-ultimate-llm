import Mathematics as math;

fibonacci( n ) {
    if ( n < 2 ) {
        return ( n );
    }
    return ( fibonacci( n - 1 ) + fibonacci( n - 2 ) );
}

main() {
    for ( i : math.natural_range( 0, 15 ) ) {
        print( "fibonacci({}) = {}\n".format( i, fibonacci( i ) ) );
    }
    return ( 0 );
}
