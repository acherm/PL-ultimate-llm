// EEL2: Hello World with Fibonacci sequence
module demo;

function fib(n)[integer]
{
    if n <= 1
        return n;
    return fib(n - 1) + fib(n - 2);
}

export procedure main()
{
    local i;
    print("Hello, World!\n");
    print("Fibonacci sequence:\n");
    for i = 0, 10
        print("fib(", i, ") = ", fib(i), "\n");
}

main();
