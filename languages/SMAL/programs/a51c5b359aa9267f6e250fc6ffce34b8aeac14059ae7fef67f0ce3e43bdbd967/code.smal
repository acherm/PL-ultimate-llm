        TITLE   'HELLO WORLD PROGRAM'
        START   BEGIN
*
* HELLO WORLD IN SMAL
*
BEGIN   LA,A1   MSG         Load address of message
        LA,A2   80          Load length
        ER      WRITE       Write to output
        J       EXIT        Jump to exit
*
MSG     + 'HELLO, WORLD!'
*
WRITE   PROCEDURE
        * Write routine would go here
        RETURN
        ENDPROC
*
EXIT    HALT
        END     BEGIN
